# Required in production: use a long, random secret (at least 32 characters).
SESSION_SECRET=replace-with-a-long-random-secret
NODE_ENV=production
PORT=3000
# For persistent hosting, point this to the mounted persistent disk path.
DATA_DIR=/var/data
# Optional: set to your exact frontend origin if cross-origin browser access is needed.
# CORS_ORIGIN=https://your-frontend.example.com
# Optional upload cap in megabytes (default 512).
TSUKYO_MAX_UPLOAD_MB=512
